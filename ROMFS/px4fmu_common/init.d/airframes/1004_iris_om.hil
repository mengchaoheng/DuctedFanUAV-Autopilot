#!/bin/sh
#
# @name Project Iris OM-MPC HITL
# @type Simulation
# @class Copter
# @maintainer Chaoheng Meng <chaohengmeng@163.com>

. ${R}etc/init.d/rc.mc_defaults

param set SYS_HITL 1
param set UAVCAN_ENABLE 0
param set-default CBRK_SUPPLY_CHK 894281

# Match the simplified 0.5 ms Iris HITL motor model and Sun allocation weights.
# SITL-derived controller/delay baseline; hardware transport delay needs HIL validation.
# Keep HITL rotor geometry below: it differs from the SITL Iris model.
param set-default CA_AIRFRAME 0
param set-default CA_METHOD 7
param set-default CA_WLS_GAM 1000000
param set-default CA_WLS_U_W 1.0
param set-default CA_WLS_R_W 3.16227766
param set-default CA_WLS_P_W 3.16227766
param set-default CA_WLS_Y_W 0.31622777
param set-default CA_WLS_FX_W 1.0
param set-default CA_WLS_FY_W 1.0
param set-default CA_WLS_FZ_W 0.03162278
param set-default MC_INDI_P_P 16
param set-default MC_INDI_R_P 16
param set-default MC_INDI_Y_P 8
param set-default MC_INDI_T_DLY 0.008
param set-default MC_ROLL_P 6.5
param set-default MC_PITCH_P 6.5
param set-default MC_YAW_P 6.5
param set-default MC_YAW_WEIGHT 1
param set-default MC_ROLLRATE_P 0.0210275054
param set-default MC_ROLLRATE_I 0.02781181782
param set-default MC_ROLLRATE_D 0
param set-default MC_ROLLRATE_MAX 1145.9156
param set-default MC_PITCHRATE_P 0.01802700385
param set-default MC_PITCHRATE_I 0.02427786589
param set-default MC_PITCHRATE_D 7.64306435e-07
param set-default MC_PITCHRATE_MAX 1145.9156
param set-default MC_YAWRATE_P 0.07362189889
param set-default MC_YAWRATE_I 0.07089558244
param set-default MC_YAWRATE_D 0.0008332142024
param set-default MC_YAWRATE_MAX 458.3662
param set-default MC_YAW_TQ_CUTOFF 0
param set-default MC_ATT_ERR_MODE 3
param set-default MPC_YAWRAUTO_ACC 360
param set-default MPC_YAWRAUTO_MAX 360
param set-default IMU_GYRO_CUTOFF 100
param set-default IMU_DGYRO_CUTOFF 8
param set-default CA_TORQ_CUTOFF 8
param set-default MC_J_X 0.0025
param set-default MC_J_Y 0.0021
param set-default MC_J_Z 0.0043
param set-default MPC_INDI_A_SRC 1
param set-default MPC_INDI_F_SRC 1
param set-default MPC_INDI_ACC_EN 1
param set-default MPC_VEL_LP 0
param set-default MPC_VELD_LP 8
param set-default MPC_VEL_NF_FRQ 0
param set-default MPC_VEL_NF_BW 5
param set-default MPC_INDI_A_LP 8
param set-default IMU_ACCEL_CUTOFF 30
param set-default CA_FORCE_CUTOFF 10
param set-default MPC_INDI_F_DLY 0.034
param set-default MPC_MASS 0.75
param set-default THR_MDL_FAC 1.0
param set-default MPC_THR_HOVER 0.2163
# Smooth position-step tuning: INDI uses velocity P only, never I or D.
# I/D below belong to PID standby. Dedicated PID gains: Tools/iris_tuning/outer_pid.params.
param set-default MPC_XY_P 1.2
param set-default MPC_Z_P 2.0
param set-default MPC_XY_VEL_P_ACC 4.0
param set-default MPC_Z_VEL_P_ACC 10.0
param set-default MPC_XY_VEL_I_ACC 1.0
param set-default MPC_Z_VEL_I_ACC 1.0
param set-default MPC_XY_VEL_D_ACC 0.4
param set-default MPC_Z_VEL_D_ACC 0.4
param set-default MPC_ACC_DOWN_MAX 15.0
param set-default MPC_ACC_HOR 15.0
param set-default MPC_ACC_HOR_MAX 15.0
param set-default MPC_ACC_UP_MAX 15.0
param set-default MPC_HOLD_MAX_XY 3.0
param set-default MPC_HOLD_MAX_Z 3.0
param set-default MPC_JERK_AUTO 80.0
param set-default MPC_JERK_MAX 500.0
param set-default MPC_MAN_TILT_MAX 70.0
param set-default MPC_MAN_Y_TAU 0.4
param set-default MPC_MAN_Y_MAX 400.0
param set-default MPC_THR_MIN 0.05
param set-default MPC_TILTMAX_AIR 89.0
param set-default MPC_VEL_MANUAL 20.0
param set-default MPC_XY_CRUISE 20.0
param set-default MPC_XY_ERR_MAX 10.0
param set-default MPC_XY_VEL_MAX 20.0
param set-default MPC_Z_VEL_MAX_DN 4.0
param set-default MPC_Z_VEL_MAX_UP 8.0
param set-default MPC_Z_V_AUTO_DN 4.0
param set-default MPC_Z_V_AUTO_UP 8.0
param set-default CA_ROTOR_COUNT 4
param set-default CA_ROTOR0_PX 0.13
param set-default CA_ROTOR0_PY 0.22
param set-default CA_ROTOR0_KM 0.0157
param set-default CA_ROTOR0_CT 8.5
param set-default CA_ROTOR1_PX -0.13
param set-default CA_ROTOR1_PY -0.20
param set-default CA_ROTOR1_KM 0.0157
param set-default CA_ROTOR1_CT 8.5
param set-default CA_ROTOR2_PX 0.13
param set-default CA_ROTOR2_PY -0.22
param set-default CA_ROTOR2_KM -0.0157
param set-default CA_ROTOR2_CT 8.5
param set-default CA_ROTOR3_PX -0.13
param set-default CA_ROTOR3_PY 0.20
param set-default CA_ROTOR3_KM -0.0157
param set-default CA_ROTOR3_CT 8.5
param set-default MC_OM_INDI_EN 1
param set-default MC_OM_ACC_EN 1
param set-default MC_OM_ACC_GAIN 1.0
param set-default MC_OM_DIST_EN 1
param set-default MC_OM_A_SRC 1
param set-default MC_OM_RATE_MAX 250.0
param set-default MC_OM_A_LP 8.0
param set-default MC_OM_D_LIM 0.0
# Same acceleration/force filter pair as position INDI; provisional HIL delay.
param set-default MC_OM_F_DLY 0.030
param set-default MC_OM_TR_T 0.0
param set-default MC_OM_KPHI_R 0.5
param set-default MC_OM_KPHI_P 0.5
param set-default MC_OM_KPHI_Y 0.0
# Small attitude reference feed-forward: fast/slow SITL comparison, 2026-09-09.
# Analytic yaw-rate commands retain unity feed-forward independently.
param set-default MC_REF_FF 0.25
param set-default MC_REF_W_N 50.0
param set-default MC_REF_FF_MAX 100.0
param set-default MC_INDI_RATE_EN 1

# USB HIL motor order; THR_MDL_FAC=1 maps thrust to rotor speed.
param set-default HIL_ACT_FUNC1 101
param set-default HIL_ACT_FUNC2 102
param set-default HIL_ACT_FUNC3 103
param set-default HIL_ACT_FUNC4 104

# Autotune identifies PID candidates; validate before applying them.
param set-default MC_AT_EN 1
param set-default MC_AT_APPLY 0
