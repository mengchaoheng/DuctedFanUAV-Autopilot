param set-default CA_SV_CS3_TRQ_R 12.8740
param set-default CA_SV_CS3_TRQ_P 0
param set-default CA_SV_CS3_TRQ_Y 28.4137
param set-default CA_SV_CS4_TRQ_R 6.4370
param set-default CA_SV_CS4_TRQ_P -11.2003
param set-default CA_SV_CS4_TRQ_Y 28.4137
param set-default CA_SV_CS5_TRQ_R -6.4370
