#!/bin/sh
#
# @name Gazebo Iris Quadrotor
#
# @type Quadrotor Wide
#
# @maintainer Julian Oes <julian@oes.ch>
#

# Reuse the complete classic Iris controller, allocation and physical defaults
# so the two simulator airframes cannot silently drift apart.
. ${R}etc/init.d-posix/airframes/10015_gazebo-classic_iris

# OM-MPC-INDI keeps acceleration feedback independent from mc_pos_control.
param set-default MC_OM_INDI_EN 1
param set-default MC_OM_ACC_EN 1
param set-default MC_OM_DIST_EN 1
param set-default MC_OM_A_SRC 1
param set-default MC_OM_RATE_MAX 250.0
param set-default MC_OM_A_LP 8.0
param set-default MC_OM_D_LIM 2.0
param set-default MC_OM_F_DLY 0.01
param set-default MC_OM_TR_T 1.0
param set-default MC_OM_KPHI_R 0.5
param set-default MC_OM_KPHI_P 0.5
param set-default MC_OM_KPHI_Y 0.0
param set-default MC_OM_R_MAX 6.0
param set-default MC_OM_P_MAX 6.0
param set-default MC_OM_Y_MAX 6.0

# Iris rate-INDI gains used by the 3 m/s OM-MPC-INDI comparison.
param set-default MC_INDI_RATE_EN 1
param set-default MC_INDI_T_DLY 0.01
param set-default MC_INDI_R_P 28.0
param set-default MC_INDI_P_P 28.0
param set-default MC_INDI_Y_P 4.0
param set-default CA_TORQ_CUTOFF 10.0

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=iris}

param set-default SIM_GZ_EN 1

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MIN4 0

# SIM_GZ_EC_MAX* is integer-valued; the model plugin retains the exact
# classic maxRotVelocity of 2372.6 rad/s and clamps the command there.
param set-default SIM_GZ_EC_MAX1 2373
param set-default SIM_GZ_EC_MAX2 2373
param set-default SIM_GZ_EC_MAX3 2373
param set-default SIM_GZ_EC_MAX4 2373
