#!/bin/sh
#
# @name ductedfan4
#
# @type Ducted Fan
#
# Author: Chaoheng Meng <chaohengmeng@163.com>



. ${R}etc/init.d/rc.mc_defaults
set VEHICLE_TYPE df

param set-default CA_AIRFRAME 16 # 9(NormalizeRPY=0)

# INDI unit contract for ducted-fan airframes:
# DF_USE_INDI and DF_USE_ACC_INDI require CA_AIRFRAME=16/17 so allocation_value
# is published in physical units. PX4 does not validate the numerical B values;
# the user must ensure CA_SV_CS*_TRQ_* maps surface deflection [rad] to angular
# acceleration [rad/s^2], CA_ROTOR*_CT/KM/axis maps motor physical thrust [N]
# into force/moment rows, and DF_CS_MAX, DF_MOT_MAX, and DF_ACC_MASS match the
# vehicle.

param set-default MC_ROLL_P 4
param set-default DF_ROLLRATE_P 0.45
param set-default DF_ROLLRATE_I 0.3
param set-default DF_ROLLRATE_D 0.0
param set-default DF_ROLLRATE_FF 0

param set-default MC_PITCH_P 4
param set-default DF_PITCHRATE_P 0.45
param set-default DF_PITCHRATE_I 0.3
param set-default DF_PITCHRATE_D 0.0
param set-default DF_PITCHRATE_FF 0

param set-default MC_YAW_P 2.8
param set-default DF_YAWRATE_P 0.4
param set-default DF_YAWRATE_I 0.3
param set-default DF_YAWRATE_D 0
param set-default DF_YAWRATE_FF 0

param set-default MPC_THR_HOVER 0.49
param set-default THR_MDL_FAC 1
param set-default RTL_RETURN_ALT 2.5
param set-default RTL_DESCEND_ALT 2.5

param set-default CA_ROTOR_COUNT 1
param set-default CA_ROTOR0_AX 0
param set-default CA_ROTOR0_AY 0
param set-default CA_ROTOR0_AZ -1
param set-default CA_ROTOR0_PX 0
param set-default CA_ROTOR0_PY 0
param set-default CA_ROTOR0_PZ 0.05
param set-default CA_ROTOR0_CT 1
param set-default CA_ROTOR0_KM 0

param set-default CA_SV_CS_COUNT 4
param set-default DF_CS_MAX 0.3491
param set-default DF_MOT_MAX 27.8
param set-default DF_MOT_ACTUATOR 0
param set-default DF_CS_ACTUATOR 1
param set-default DF_CS_TCONST 0.01
# param set-default DF_MOT_TCONST 0.03 #(in motor plugins)
param set-default DF_MOT_CUTOFF 6
param set-default DF_CS_CUTOFF 8
param set-default IMU_DGYRO_CUTOFF 10
param set-default DF_ACC_MASS 1.39

param set-default MC_ATT_ERR_MODE 3

param set-default CA_SV_CS0_TRQ_R -41.4452
param set-default CA_SV_CS0_TRQ_P 0
param set-default CA_SV_CS0_TRQ_Y 40.4016
param set-default CA_SV_CS1_TRQ_R 0
param set-default CA_SV_CS1_TRQ_P -41.3015
param set-default CA_SV_CS1_TRQ_Y 40.4016
param set-default CA_SV_CS2_TRQ_R 41.4452
param set-default CA_SV_CS2_TRQ_P 0
param set-default CA_SV_CS2_TRQ_Y 40.4016
param set-default CA_SV_CS3_TRQ_R 0
param set-default CA_SV_CS3_TRQ_P 41.3015
param set-default CA_SV_CS3_TRQ_Y 40.4016

param set-default PWM_MAIN_FUNC1 101

param set-default PWM_MAIN_FUNC2 201
param set-default PWM_MAIN_FUNC3 202
param set-default PWM_MAIN_FUNC4 203
param set-default PWM_MAIN_FUNC5 204

param set-default SDLOG_PROFILE 27
param set-default SDLOG_MODE 0
