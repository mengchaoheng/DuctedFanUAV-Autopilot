#!/bin/sh
#
# @name Ducted Fan 4 SIH
# @type Ducted Fan
# @class DuctedFan
#
# SIH counterpart of 22002_gazebo-classic_ductedfan4.
#

. ${R}etc/init.d-posix/airframes/22002_gazebo-classic_ductedfan4

# Small extra body damping, informed by flight logs but not a unique plant fit.
# Keep this separate from the vane aerodynamic forces/moments below.
# Low-speed effective hull drag fitted to flight logs 108/109.
# Like the Gazebo DF4 hull force, it acts at the vehicle centre of mass.
param set-default SIH_KDV 0.9
param set-default SIH_KDW 0.003

# Flight logs 108/109: fit the 8-20 Hz sensor floor through the 250 Hz front-end.
# The larger >20 Hz flight residual contains vibration: replacing all of it
# with white noise overexcites the low-frequency INDI acceleration feedback.
# High-frequency structural vibration is not reproduced by this white model.
param set-default SIH_GYRO_XY 0.01
param set-default SIH_GYRO_Z 0.02
param set-default SIH_ACC_XY 0.1
param set-default SIH_ACC_Z 0.1

PX4_SIMULATOR=${PX4_SIMULATOR:=sihsim}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=ductedfan4}

param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 1
param set-default SENS_GPS0_DELAY 0
param set-default SENS_GPS1_DELAY 0

# Generic ducted-fan branch in simulator_sih.
param set SIH_VEHICLE_TYPE 6

# Match the current ductedfan4 Gazebo/airframe rigid-body model.
param set-default SIH_MASS 1.56
param set-default SIH_IXX 0.01149
param set-default SIH_IYY 0.01153
param set-default SIH_IZZ 0.00487
param set-default SIH_IXY 0
param set-default SIH_IXZ 0
param set-default SIH_IYZ 0

# Rotor maximum thrust for the simple DF plant, independent of allocation.
param set-default SIH_T_MAX 29.9584438

# Vane cp is 0.156 m below base_link; CAD CoM is 0.011 m above it.
# SIH integrates at the CoM, while the Gazebo cp is relative to base_link.
param set-default SIH_DF_ARM 0.167

# Rotor response is unchanged; the servo candidate is shared with Gazebo.
param set-default SIH_T_TAU 0.03

# KST X08H V6 at 8 V: 10 ms first-order approximation, pending bench calibration.
param set-default SIH_SV_TAU 0.01

# Authority-normalized sine preset, shared with Classic/gz (2026-10-22).
# F/(m*a_cap): 3/3/10%; tau/(J*alpha_cap): 5/5/3%, XYZ/RPY.
# Vertical a_cap is the smaller upward/downward thrust reserve; see the
# hover_indi6_authority report for physical limits and FRD/FLU conversion.
# SIH_DIST_EN=0 disables loads; enabling starts one 1000 s window immediately.
param set-default SIH_DIST_EN 0
param set-default SIH_DIST_START 0
param set-default SIH_DIST_DUR 1000
param set-default SIH_DF_BX 0
param set-default SIH_DF_BY 0
param set-default SIH_DF_BZ 0
param set-default SIH_DF_AX 0.458960563
param set-default SIH_DF_AY 0.458960563
param set-default SIH_DF_AZ 1.17036721
param set-default SIH_DF_HX 0.1
param set-default SIH_DF_HY 0.2
param set-default SIH_DF_HZ 0.3
param set-default SIH_DM_BX 0
param set-default SIH_DM_BY 0
param set-default SIH_DM_BZ 0
param set-default SIH_DM_AX 0.0173225155
param set-default SIH_DM_AY 0.0173225155
param set-default SIH_DM_AZ 0.00858864842
param set-default SIH_DM_HX 0.2
param set-default SIH_DM_HY 0.4
param set-default SIH_DM_HZ 0.2
