#!/bin/sh
# DF4 controller defaults shared by Classic, gz and (via Classic) SIH.
# Baseline: flight logs 108/109, 2026-08-19. Horizontal gains and INDI
# feedback filters refined by the 2026-10-22 SIH hover comparisons.
# Controller/filter and trajectory defaults are shared: each simulator keeps its own
# sensor setup, actuator mapping and physical plant. Saved parameters still win.

# Attitude and PID rate control.
param set-default MC_ATT_ERR_MODE 3
param set-default MC_ROLL_P 6
param set-default MC_PITCH_P 6
param set-default MC_YAW_P 5
param set-default MC_YAW_WEIGHT 1
param set-default MC_ROLLRATE_K 1
param set-default MC_ROLLRATE_P 0.4
param set-default MC_ROLLRATE_I 0.3
param set-default MC_ROLLRATE_D 0
param set-default MC_ROLLRATE_FF 0
param set-default MC_PITCHRATE_K 1
param set-default MC_PITCHRATE_P 0.4
param set-default MC_PITCHRATE_I 0.3
param set-default MC_PITCHRATE_D 0
param set-default MC_PITCHRATE_FF 0
param set-default MC_YAWRATE_K 1
param set-default MC_YAWRATE_P 0.3
param set-default MC_YAWRATE_I 0.2
param set-default MC_YAWRATE_D 0
param set-default MC_YAWRATE_FF 0
param set-default MC_RR_INT_LIM 0.3
param set-default MC_PR_INT_LIM 0.3
param set-default MC_YR_INT_LIM 0.3
param set-default MC_ROLLRATE_MAX 220
param set-default MC_PITCHRATE_MAX 220
param set-default MC_YAWRATE_MAX 200
param set-default MC_YAW_TQ_CUTOFF 0
param set-default MC_AIRMODE 0
param set-default MC_BAT_SCALE_EN 0
param set-default MC_AT_EN 0

# SITL feedback tuning: 20 Hz acceleration/torque filters and no fixed notches.
# The flown fixed-notch bandwidths remain inert while their frequencies are zero.
param set-default IMU_GYRO_RATEMAX 800
param set-default IMU_GYRO_CUTOFF 100
param set-default IMU_DGYRO_CUTOFF 20
param set-default IMU_GYRO_NF0_FRQ 0
param set-default IMU_GYRO_NF0_BW 10
param set-default IMU_GYRO_NF1_FRQ 0
param set-default IMU_GYRO_NF1_BW 10
param set-default IMU_GYRO_DNF_EN 0
param set-default IMU_ACCEL_CUTOFF 30

# INDI stays disabled by default; enable it explicitly after takeoff.
# The 4 ms torque delay is the validated SITL candidate, not a hardware calibration.
param set-default MC_INDI_RATE_EN 0
param set-default MPC_INDI_ACC_EN 0
param set-default MC_INDI_R_P 12
param set-default MC_INDI_P_P 12
param set-default MC_INDI_Y_P 12
param set-default MC_INDI_T_DLY 0.004
param set-default MC_J_X 0.01149
param set-default MC_J_Y 0.01153
param set-default MC_J_Z 0.00487
param set-default MPC_INDI_A_SRC 1
param set-default MPC_INDI_A_LP 8
param set-default MPC_INDI_F_SRC 1
param set-default MPC_INDI_F_DLY 0.035
param set-default MPC_INDI_TR_T 1
param set-default CA_FORCE_CUTOFF 8
param set-default CA_TORQ_CUTOFF 20

# Position/velocity control and force scaling.
param set-default MPC_XY_P 1.2
param set-default MPC_Z_P 1
param set-default MPC_XY_VEL_P_ACC 4
param set-default MPC_XY_VEL_I_ACC 1
param set-default MPC_XY_VEL_D_ACC 0.4
param set-default MPC_Z_VEL_P_ACC 4
param set-default MPC_Z_VEL_I_ACC 2
param set-default MPC_Z_VEL_D_ACC 0
param set-default MPC_VEL_LP 0
param set-default MPC_VELD_LP 8
param set-default MPC_VEL_NF_FRQ 0
param set-default MPC_VEL_NF_BW 5
param set-default MPC_ACC_DECOUPLE 1
param set-default MPC_MASS 1.56
param set-default MPC_THR_HOVER 0.51
param set-default MPC_THR_MIN 0.12
param set-default MPC_THR_MAX 1
param set-default MPC_THR_XY_MARG 0.3
param set-default THR_MDL_FAC 1

# Independent horizontal/vertical presets shared by all three DF4 simulators.
# MC_ORBIT_SHAPE: 0=horizontal circle, 1=horizontal figure eight,
# 2=vertical circle, 3=vertical figure eight. Exit and re-enter Orbit to switch.
param set-default MC_ORBIT_SHAPE 2
param set-default MC_HCIRC_AX 4.5
param set-default MC_HCIRC_AY 4.5
param set-default MC_HCIRC_OMEGA 0.6
param set-default MC_CIRC_ACC 5
param set-default MC_HF8_AX 4.5
param set-default MC_HF8_AY 4.5
param set-default MC_HF8_OMEGA 0.3
param set-default MC_F8_HDG 90
param set-default MC_F8_ACC 10
param set-default MC_VCIRC_AX 2
param set-default MC_VCIRC_AZ 2
param set-default MC_VCIRC_OMEGA 0.4
param set-default MC_VF8_AX 2
param set-default MC_VF8_AZ 2
param set-default MC_VF8_OMEGA 0.25
param set-default MC_ORB_OM_TIME 0

# Trajectory limits; the experiment may override the path, not the controller.
param set-default MPC_VEL_MANUAL 6
param set-default MPC_XY_CRUISE 5
param set-default MPC_XY_VEL_MAX 8
param set-default MPC_Z_VEL_MAX_DN 1
param set-default MPC_Z_VEL_MAX_UP 3
param set-default MPC_Z_V_AUTO_DN 1
param set-default MPC_Z_V_AUTO_UP 3
param set-default MPC_ACC_HOR 5
param set-default MPC_ACC_HOR_MAX 5
param set-default MPC_ACC_UP_MAX 4
param set-default MPC_ACC_DOWN_MAX 3
param set-default MPC_JERK_AUTO 4
param set-default MPC_JERK_MAX 8
param set-default MPC_TILTMAX_AIR 45
param set-default MPC_YAWRAUTO_ACC 180
param set-default MPC_YAWRAUTO_MAX 90
param set-default MPC_LAND_SPEED 0.6

# Use constrained WLS with the existing physical effectiveness model.
param set-default CA_METHOD 7
param set-default CA_ROTOR0_CT 30
# Physical WLS factors W_z=I, W_mu=I (thrust in N, vane angles in rad).
# With the current block-diagonal model, divide the motor cost by 30^2
# and the surface cost by 0.3491^2 without changing either minimizer.
# Thus one actuator factor suffices: force factor=1, torque factors=1/(0.3491*D_tau).
# Recompute these factors if the geometry or maximum vane angle changes.
param set-default CA_WLS_GAM 1000000
param set-default CA_WLS_U_W 1
param set-default CA_WLS_FX_W 1
param set-default CA_WLS_FY_W 1
param set-default CA_WLS_FZ_W 1
param set-default CA_WLS_R_W 0.67339009
param set-default CA_WLS_P_W 0.67339009
param set-default CA_WLS_Y_W 0.78694933

# Shared OM-MPC grid and weights. The larger body-rate penalty accommodates
# DF4 actuator dynamics; MPC and its middle layer are enabled only on request.
param set-default MPC_OM_RATE 50
param set-default MPC_OM_N 15
param set-default MPC_OM_DT 0.04
param set-default MPC_OM_QPOS 486
param set-default MPC_OM_QVEL 10
param set-default MPC_OM_QROT 8.64
param set-default MPC_OM_RTHR 0.25
param set-default MPC_OM_ROMG 20
param set-default MPC_OM_PFAC 1
