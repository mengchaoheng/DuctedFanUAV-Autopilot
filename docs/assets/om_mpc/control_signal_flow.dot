// Editable signal-flow figure; keep equations, modules and message fields aligned with control code.
// Boxes describe module purpose, calculation and outputs. Edges carry uORB names and key fields.
// Main-path topics are also logged; dashed edges add diagnostic-only paths.
// Render: neato -n2 -Tsvg docs/assets/om_mpc/control_signal_flow.dot -o docs/assets/om_mpc/control_signal_flow.svg
digraph control_signal_flow {
  graph [layout=neato, bgcolor="white", pad=0.3, fontname="PingFang SC", fontsize=24, labelloc=t, label="本机控制信号流 · 论文符号 / uORB 消息\n方框：模块 / 作用 / 计算 / 输出；线上：粗体消息名 + 关键字段 → 数学量\n蓝线：控制信号；橙线：分配反馈；紫线：扰动反馈；青绿色虚线：额外诊断消息"];
  node [shape=box, style="rounded,filled", fillcolor="#e8f1fb", color="#3973a8", fontname="PingFang SC", fontsize=20, fixedsize=true, pin=true];
  edge [fontname="PingFang SC", fontsize=18, color="#0066cc", arrowsize=0.85, penwidth=1.8];
  REF [pos="900,2860!", width=10.00000, height=2.77778, fillcolor="#e8f1fb", color="#3973a8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>FlightTaskFigureEight / FlightTaskOrbit</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#172b3a">作用：生成轨迹几何、相位及任务参考</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">s_i = A_i sin(h_i φ + δ_i)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">pᵈ = c + R_z(χ)s；vᵈ = ṗᵈ；aᵈ = p̈ᵈ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">推进基础相位 φ，允许相位速度渐变；保持参考航向 ψᵈ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>输出：轨迹几何 / 相位；pᵈ、vᵈ、aᵈ、ψᵈ</B></FONT></TD></TR></TABLE>>];
  POS [pos="280,2390!", width=6.94444, height=4.58333, fillcolor="#e8f1fb", color="#3973a8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>mc_pos_control / PositionControl</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#172b3a">作用：原位置控制；可选原位置加速度 INDI</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">v_sp = vᵈ + K_p(pᵈ − p)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">PID：a_c = aᵈ + K_v(v_sp − v) + I_v − K_D a_f</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">INDI：a_c = aᵈ + K_v(v_sp − v)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">β_c = β_f + a_c − a_f</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">执行推力映射、原分支切换平滑及限制</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">推力方向与 ψᵈ → R_sp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>输出：R_sp、t_spᵖᵒˢ；原位置 INDI 诊断</B></FONT></TD></TR></TABLE>>];
  MPC [pos="900,2390!", width=8.33333, height=4.16667, fillcolor="#e8f1fb", color="#3973a8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>mc_pos_control · OmMpc 工作线程</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#172b3a">作用：重建参考、线性化并求解受约束 QP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">输入估计 p、v、R；由轨迹重建 xᵈ、uᵈ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">v̇ = g e₃ − a_T R e₃ + d̄；Ṙ = R[ω]×</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">J = Σ(‖δx‖_Q² + ‖δu‖_R²) + ‖δx_N‖_P²</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">δu* = argmin J，受预测模型与输入约束限制</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">d̄ = κ_d d̂（有效时）；提取首个最优输入</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>输出：a_Tᴹ、ωᴹ、tᴹ；QP 实际使用的 d̄</B></FONT></TD></TR></TABLE>>];
  TI [pos="2050,2390!", width=10.13889, height=6.66667, fillcolor="#e8f1fb", color="#3973a8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>mc_om_mpc_acc_indi</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#172b3a">作用：匹配反馈，修正标称推力与角速度</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">原始力转 NED → 滤波 / 延迟匹配；加速度滤波</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">β_M = −a_Tᴹ R e₃；β_c = β_f + g e₃ + β_M + d̄ − a_f</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">a_Tᶜ = ‖β_c‖；b₃c = −β_c / ‖β_c‖</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">tᶜ = −clip(h a_Tᶜ / g, 0, 1)e₃</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">e_φ = Log(RᵀR_c)（最小推力轴旋转）</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">ωᶜ = ωᴹ + K_φ e_φ（内部原始修正量）</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">η = S(clip(t_acc / T_acc, 0, 1))</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">T_acc = MPC_ACCINDI_TR_T；T_acc = 0 时 η = 1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">ω_cmd = ωᴹ + η(ωᶜ − ωᴹ)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">t_cmd = tᴹ + η(tᶜ − tᴹ)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">d̂ = a_f − g e₃ − β_f（可限幅）</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>输出：ω_cmd、t_cmd；a_f、β_f、e_φ；d̂</B></FONT></TD></TR></TABLE>>];
  SELECT [pos="1440,1610!", shape=plain, style="", fixedsize=false, margin=0, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="12" COLOR="#3973a8"><TR><TD WIDTH="600" HEIGHT="600" FIXEDSIZE="TRUE" BGCOLOR="#e8f1fb" ALIGN="CENTER" VALIGN="MIDDLE"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>mc_att_control</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#172b3a">作用：原姿态控制、最终指令选择及 MPC 接管</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">原姿态环：ω_att = clip(K_att ⊙ e_att + ω_FF)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">定义 c = [ω；t_body]；选 c_tar = cᴹ 或 c_cmd</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">c_anchor：上一拍实际输出；不可用时取原姿态环</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">MPC 接入 t₀：Δc₀ = c_anchor − c_tar(t₀)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">p = S(clip((t − t₀)/T_takeover, 0, 1))</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">S(r) = 3r² − 2r³；T_takeover = MPC_TAKEOVER_T</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">c_pre = c_tar + (1 − p)Δc₀ → 切入限幅 → c_sp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">退出 MPC：直接回原姿态环；p 与 η 独立</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>输出：ω_sp、t_sp；最终采用标志及 p</B></FONT></TD></TR></TABLE></TD><TD WIDTH="1080" HEIGHT="600" FIXEDSIZE="TRUE" BGCOLOR="#f3f8f5" ALIGN="CENTER" VALIGN="MIDDLE"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3" CELLPADDING="7"><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a"><B>姿态误差选项 · MC_ATT_ERR_MODE（0 原版；1–7 新增）</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#172b3a">参考模型输出 R_ref、q_ref；R_e = RᵀR_ref；q_e = q⁻¹ ⊗ q_ref = [s, v]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">θ、n：相对旋转角与轴；w = MC_YAW_WEIGHT；canon：四元数符号规范化；sgn₊(0) = 1</FONT></TD></TR><TR><TD WIDTH="500" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#eaf2ed"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>0 原版 PX4：约化姿态 + 航向加权</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">q_red：仅将 R e₃ 对齐 R_ref e₃</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">q_mix = q_red ⊗ (q_red⁻¹ ⊗ q_ref)ʷ</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">e_att = 2 Im(canon(q⁻¹ ⊗ q_mix))</FONT></TD><TD WIDTH="500" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#eaf2ed"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>1 四元数虚部（全姿态）</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">e_att = 2 Im(canon(q_e))</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">          = 2 n sin(θ / 2)</FONT></TD></TR><TR><TD WIDTH="500" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#f3f8f5"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>2 四元数 Log（全姿态）</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">q̄_e = canon(q_e) = [s̄, v̄]</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">e_att = 2 atan2(‖v̄‖, s̄) v̄ / ‖v̄‖ = θ n</FONT></TD><TD WIDTH="500" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#f3f8f5"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>3 旋转矩阵 Log（全姿态）</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">e_att = Log(R_e)∨ = θ n</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">          = θ (R_e − R_eᵀ)∨ / (2 sin θ)</FONT></TD></TR><TR><TD WIDTH="500" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#eaf2ed"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>4 旋转矩阵 vee（Lee）</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">e_att = ½(R_e − R_eᵀ)∨ = n sin θ</FONT></TD><TD WIDTH="500" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#eaf2ed"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>5 增量姿态指令（Tal–Karaman）</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">ξ_t：当前机体系中 e₃ → R_e e₃ 的最小旋转</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">n_ψ = [sin ψ_ref, −cos ψ_ref, 0]ᵀ</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">n̄ = R(q ⊗ ξ_t)ᵀ n_ψ；κ = −n̄_x / n̄_y</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">ξ_ψ = normalize([1, 0, 0, κ / (1 + √(1 + κ²))])</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">e_att = Log(ξ_t ⊗ ξ_ψ)</FONT></TD></TR><TR><TD WIDTH="500" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#f3f8f5"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>6 倾斜优先四元数（Brescianini / Sun）</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">a = √(s² + v_z²)</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">e_att = (2 / a) [s v_x − v_y v_z,</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">          s v_y + v_x v_z, w sgn₊(s) v_z]ᵀ</FONT></TD><TD WIDTH="500" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#f3f8f5"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>7 倾斜–扭转 Log（Yu）</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">R_t：e₃ → R_e e₃ 的最小旋转；R_ψ = R_e R_tᵀ</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">z_t = R_t e₃；P_t = z_t z_tᵀ</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#172b3a">e_att = Log(R_t)∨ + w P_t Log(R_ψ)∨</FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#52677a">w 仅用于 0 / 6 / 7；2 / 3 等价，代码使用稳健主值 Log 处理零角 / π 附近。</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="18" COLOR="#b04722">仅影响原姿态环；MPC 接管后直接采用 ωᴹ / ω_cmd，不经过这组姿态误差计算。</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  RATE [pos="900,980!", width=8.33333, height=4.16667, fillcolor="#e8f1fb", color="#3973a8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>mc_rate_control</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#172b3a">作用：角速度跟踪；选择 rate PID 或旋转 INDI</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">e_ω = ω_sp − ω；反馈角加速度为 α_f</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">PID：τ̄ = K_P e_ω + I_ω − K_D α_f + K_FF ω_sp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">INDI：α_c = K_ω e_ω；τ_c = τ_f + J(α_c − α_f)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">τ̄_INDI = D_τ τ_c；τ̄_H = D_τ(τ_f − Jα_f)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">延迟 τ_LPF → τ_f；执行输出滤波与比例处理</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">备用 PID 持续积分；PID ↔ INDI 直接切换</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>输出：归一化 τ̄_sp、t_sp；PCA 高优先级分量</B></FONT></TD></TR></TABLE>>];
  CA [pos="1520,390!", shape=plain, style="", fixedsize=false, margin=0, label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="12" COLOR="#3973a8"><TR>
      <TD WIDTH="600" HEIGHT="450" FIXEDSIZE="TRUE" BGCOLOR="#e8f1fb" ALIGN="CENTER" VALIGN="MIDDLE">
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>control_allocator</B></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#172b3a">作用：归一化力矩 / 推力 → 受约束执行器指令</FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">输入：c_alloc = [τ̄_sp；t_sp]；v = c_alloc − c_trim</FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">分配：z* = Allocate(A, v, Z)；u* = u_trim + z*</FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">后处理：机型修正 → 速率限制 → 限幅 → u_final</FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">反馈重建：[τ̂；F̂] = B_phys(u_final − u_trim)</FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">共享滤波：τ_f = LPF_τ(τ̂)；F_f = LPF_F(F̂)</FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">计时：测量每个矩阵本次 allocate() 调用</FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a">CA16/17：矩阵0分配推力，矩阵1分配力矩</FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#3973a8"><B>输出：u_final、原始 / 滤波反馈、逐次诊断</B></FONT></TD></TR>
        </TABLE>
      </TD>
      <TD WIDTH="1240" HEIGHT="450" FIXEDSIZE="TRUE" BGCOLOR="#f3f8f5" ALIGN="CENTER" VALIGN="MIDDLE">
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
          <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="20" COLOR="#172b3a"><B>分配方法与模型（对照 v1.18.0-beta1）</B></FONT></TD></TR>
          <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#e8eef4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1180"><TR>
            <TD WIDTH="70" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#52677a"><B>原版：</B></FONT></TD>
            <TD WIDTH="340" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#52677a">0 伪逆 + 限幅</FONT></TD>
            <TD WIDTH="340" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#52677a">1 顺序去饱和</FONT></TD>
            <TD WIDTH="390" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#52677a">2 AUTO（按机型选择）</FONT></TD>
          </TR></TABLE></TD></TR>
          <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#faeee4"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" WIDTH="1180"><TR>
            <TD WIDTH="70" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#b04722"><B>新增：</B></FONT></TD>
            <TD WIDTH="130" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#b04722">3 INV</FONT></TD>
            <TD WIDTH="180" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#b04722">4 DP_LPCA</FONT></TD>
            <TD WIDTH="250" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#b04722">5 DPscaled_LPCA</FONT></TD>
            <TD WIDTH="220" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#b04722">6 PCA（优先级）</FONT></TD>
            <TD WIDTH="290" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#b04722">7 WLS（QCAT 活动集）</FONT></TD>
          </TR></TABLE></TD></TR>
          <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#172b3a">论文模型：μ = Bz；μ_c = [T_c, τ_cᵀ]ᵀ<BR ALIGN="LEFT"/>实现坐标：A = B_unit = D B_phys；v = c − c_trim；z = u − u_trim ∈ Z；z_d = 0<BR ALIGN="LEFT"/></FONT></TD></TR>
          <TR>
            <TD WIDTH="580" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#eaf2ed"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>3 INV</B><BR ALIGN="LEFT"/>z = clip_Z(A⁺v)</FONT></TD>
            <TD WIDTH="580" ALIGN="LEFT" VALIGN="TOP" BGCOLOR="#eaf2ed"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>4 DP_LPCA</B><BR ALIGN="LEFT"/>max ρ；Az = ρv，z ∈ Z，0 ≤ ρ ≤ 1</FONT></TD>
          </TR>
          <TR>
            <TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>5 DPscaled_LPCA（降维边界求解）</B><BR ALIGN="LEFT"/>max ρ_b；Az_b = ρ_b v，z_b ∈ Z，ρ_b ≥ 0<BR ALIGN="LEFT"/>z = z_b / max(1, ρ_b)<BR ALIGN="LEFT"/></FONT></TD>
            <TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>6 PCA（优先保留 v_H）</B><BR ALIGN="LEFT"/>max ρ；Az = v_H + ρv_L，z ∈ Z，0 ≤ ρ ≤ 1<BR ALIGN="LEFT"/>高优先级不可行时，先对 v_H 做方向保持分配<BR ALIGN="LEFT"/></FONT></TD>
          </TR>
          <TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#eaf2ed"><FONT POINT-SIZE="18" COLOR="#172b3a"><B>7 WLS：</B>min<SUB>z∈Z</SUB> ‖W<SUB>z</SUB>(z − z<SUB>d</SUB>)‖₂² + η<SUB>WLS</SUB> ‖W<SUB>v</SUB>(Az − v)‖₂²</FONT></TD></TR>
          <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#52677a">LPCA 系列随后保输出恢复：Az_r = Az，z_r ∈ Z；PCA：v_H 为 INDI 反馈分量，v_L 为其余分量<BR ALIGN="LEFT"/>物理反馈重建：[τ̂ᵀ, F̂ᵀ]ᵀ = B_phys (u − u_trim)<BR ALIGN="LEFT"/></FONT></TD></TR>
          <TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="18" COLOR="#b04722"><B>CA16/17（方法 4–7）：矩阵0分配力 → INV；矩阵1分配力矩 → 所选方法</B></FONT></TD></TR>
        </TABLE>
      </TD>
    </TR></TABLE>
  >];
